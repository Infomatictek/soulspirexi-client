      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>LUASOCKET_API=;_WINSOCK_DEPRECATED_NO_WARNINGS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
  <!-- AsmJit (third_party\asmjit, its x86 assembler only) and AsmTK (third_party\asmtk, AsmJit's text parser), as they
       are, for Ashita addons' ashita.memory.assembler (asm_text.cpp): their own warning level, objects in a folder of
       their own (AsmJit's assembler.cpp, string.cpp, ... aren't VanaCore's) -->
  <ItemGroup>
    <ClCompile Include="..\..\third_party\asmjit\asmjit\core\*.cpp;..\..\third_party\asmjit\asmjit\support\*.cpp;..\..\third_party\asmjit\asmjit\x86\*.cpp;..\..\third_party\asmtk\asmtk\*.cpp">
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\third_party\asmjit;$(MSBuildThisFileDirectory)..\..\third_party\asmtk;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ASMJIT_STATIC;ASMTK_STATIC;ASMJIT_NO_AARCH64;ASMJIT_NO_UJIT;ASMJIT_NO_COMPILER;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ObjectFileName>$(IntDir)asmjit\%(Filename).obj</ObjectFileName>
    </ClCompile>
    <ClCompile Include="asm_text.cpp">
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\third_party\asmjit;$(MSBuildThisFileDirectory)..\..\third_party\asmtk;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ASMJIT_STATIC;ASMTK_STATIC;ASMJIT_NO_AARCH64;ASMJIT_NO_UJIT;ASMJIT_NO_COMPILER;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>
