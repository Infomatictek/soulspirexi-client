  <PropertyGroup>
    <TargetName>VanaCore.Core</TargetName>
    <!-- LuaJIT, built from third_party\luajit by third_party\build-luajit.cmd before the first compile. -->
    <LuaJitDir>$(MSBuildThisFileDirectory)..\..\build\obj\luajit\$(Configuration)\</LuaJitDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LuaJitDir)src;$(MSBuildThisFileDirectory)..\..\third_party\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>VanaCore.Core.def</ModuleDefinitionFile>
      <!-- VanaCore.Core.map beside the DLL: /vana stats' sampler names VanaCore's own functions from it -->
      <GenerateMapFile>true</GenerateMapFile>
      <!-- imm32: ImGui's text boxes place the IME's window (Japanese input) -->
      <AdditionalDependencies>$(LuaJitDir)lua51.lib;d3d11.lib;d3d12.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;delayimp.lib;imm32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Direct3D 12 (renderer=d3d12) exists from Windows 10: loaded only when it's used, so VanaCore.Core
           still loads without it -->
      <DelayLoadDLLs>d3d11.dll;d3d12.dll;dxgi.dll;d3dcompiler_47.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
    <PostBuildEvent>
      <Message>Copying addons, scripts and fonts to $(OutDir)</Message>
      <!-- Addons: newer files replace older ones. Scripts: only those not there yet, so a player's
           own edits (boot.txt) survive a rebuild. -->
      <Command>xcopy /D /E /I /Y /Q "$(MSBuildThisFileDirectory)..\..\addons" "$(OutDir)addons" &gt;nul
if errorlevel 1 exit /b 1
robocopy "$(MSBuildThisFileDirectory)..\..\scripts" "$(OutDir)scripts" /E /XC /XN /XO /NJH /NJS /NP /NFL /NDL &gt;nul
if errorlevel 8 exit /b 1
xcopy /D /E /I /Y /Q "$(MSBuildThisFileDirectory)..\..\fonts" "$(OutDir)fonts" &gt;nul
if errorlevel 1 exit /b 1
exit /b 0</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <LuaJitSource Include="..\..\third_party\luajit\src\*.c;..\..\third_party\luajit\src\*.h;..\..\third_party\luajit\src\*.dasc;..\..\third_party\build-luajit.cmd" />
  </ItemGroup>
  <!-- Rebuilds LuaJIT when any of its sources (or the script) is newer than the library. -->
  <Target Name="BuildLuaJit" BeforeTargets="ClCompile;ResourceCompile" Inputs="@(LuaJitSource)" Outputs="$(LuaJitDir)lua51.lib">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)..\..\third_party\build-luajit.cmd&quot; $(Configuration) &quot;$(MSBuildThisFileDirectory)..\..\build\obj\luajit\$(Configuration)&quot;" />
  </Target>
